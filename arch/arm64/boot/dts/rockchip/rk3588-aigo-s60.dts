/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/usb/pd.h>
#include "rk3588.dtsi"

/ {
	model = "Aigo S60";
	compatible = "rockchip,rk3588-aigo-s60", "rockchip,rk3588";

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
		mmc2 = &sdio;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
	};

	/* ADC keys on saradc channel 1, matching the official 6.1 BSP.
	 * The official DT configures only a vol-up key (threshold 1758μV). */
	adc-keys-0 {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		vol-up-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <1750>;
		};
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	hdmi0-con {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi0_con_in: endpoint {
				remote-endpoint = <&hdmi0_out_con>;
			};
		};
	};

	hdmi1-con {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi1_con_in: endpoint {
				remote-endpoint = <&hdmi1_out_con>;
			};
		};
	};

	/* LEDs on gpio1 (gpio@fec20000), matching the official 6.1 BSP.
	 * The official DT uses net-led (gpio1 pin 0) and work-led (gpio1
	 * pin 1). The earlier nca9555 I2C GPIO-expander references are gone
	 * because i2c6 is disabled and the expander was never probed. */
	leds {
		compatible = "gpio-leds";

		work_led: work-led {
			gpios = <&gpio1 RK_PA1 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};

		net_led: net-led {
			gpios = <&gpio1 RK_PA0 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	/* PWM fan for thermal cooling, matching the official 6.1 BSP.
	 * The fan is on pwm14 (pwm@febf0020), NOT pwm1. Uses pwm14m0_pins
	 * as in the official DT. */
	fan: pwm-fan {
		compatible = "pwm-fan";
		cooling-levels = <0 50 100 150 200 255>;
		fan-supply = <&vcc5v0_sys>;
		pwms = <&pwm14 0 50000 0>;
		#cooling-cells = <2>;
	};

	/* sound node removed — es8388 codec was on i2c7, now disabled */

	vcc12v_dcin: regulator-vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	/* vcc5v0_sys powers peripherals */
	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	/* vcc4v0_sys powers the RK806, RK860's */
	vcc4v0_sys: regulator-vcc4v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc4v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <4000000>;
		regulator-max-microvolt = <4000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc_1v1_nldo_s3: regulator-vcc-1v1-nldo-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-1v1-nldo-s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		vin-supply = <&vcc4v0_sys>;
	};

	vcc_3v3_pcie20: regulator-vcc3v3-pcie20 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_pcie20";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	vbus5v0_typec: regulator-vbus5v0-typec {
		compatible = "regulator-fixed";
		enable-active-high;
		regulator-name = "vbus5v0_typec";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc5v0_host: regulator-vcc5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc3v3_pcie30: regulator-vcc3v3-pcie30 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio2 RK_PC5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pcie_m2_0_pwren>;
		regulator-name = "vcc3v3_pcie30";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <5000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc3v3_sd_s0: regulator-vcc3v3-sd-s0 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&sd_s0_pwren>;
		regulator-name = "vcc3v3_sd_s0";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	/* RTL8365MB switch (switch0): 5 user ports (eth2..eth6).
	 * CPU port @7 connects to gmac1 (end1) via RGMII. Bit-bang SMI on gpio4.
	 * Pin mapping taken from the official 6.1 BSP device tree.
	 * Each port has a fixed label and local-mac-address (02:00:00:00:00:0x)
	 * so the names and MACs are stable across reboots. The GMAC masters
	 * are named end0/end1 (via their label property), leaving ethN free
	 * for the slave ports. */
	switch0: switch0 {
		compatible = "realtek,rtl8365mb";
		mdc-gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
		mdio-gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio4 RK_PC0 GPIO_ACTIVE_LOW>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "eth1";
				local-mac-address = [02 00 00 00 00 03];
				phy-handle = <&sw0_phy0>;
			};

			port@1 {
				reg = <1>;
				label = "eth2";
				local-mac-address = [02 00 00 00 00 04];
				phy-handle = <&sw0_phy1>;
			};

			port@2 {
				reg = <2>;
				label = "eth3";
				local-mac-address = [02 00 00 00 00 05];
				phy-handle = <&sw0_phy2>;
			};

			port@3 {
				reg = <3>;
				label = "eth4";
				local-mac-address = [02 00 00 00 00 06];
				phy-handle = <&sw0_phy3>;
			};

			port@4 {
				reg = <4>;
				label = "eth5";
				local-mac-address = [02 00 00 00 00 07];
				phy-handle = <&sw0_phy4>;
			};

			port@7 {
				reg = <7>;
				ethernet = <&gmac1>;
				phy-mode = "rgmii";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};

		mdio {
			compatible = "realtek,smi-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			sw0_phy0: ethernet-phy@0 {
				reg = <0>;
			};

			sw0_phy1: ethernet-phy@1 {
				reg = <1>;
			};

			sw0_phy2: ethernet-phy@2 {
				reg = <2>;
			};

			sw0_phy3: ethernet-phy@3 {
				reg = <3>;
			};

			sw0_phy4: ethernet-phy@4 {
				reg = <4>;
			};
		};
	};

	/* RTL8367RB switch (switch1): 5 user ports (eth7..eth11).
	 * CPU port @6 connects to gmac0 (end0) via RGMII. Bit-bang SMI on gpio4.
	 * The upstream rtl8365mb driver auto-detects the chip by id; a
	 * matching compatible ("realtek,rtl8367rb") is added there.
	 * Each port has a fixed label and local-mac-address. */
	switch1: switch1 {
		/* fnos ships the upstream rtl8365mb.ko module whose
		 * of_match_table only lists "realtek,rtl8365mb" (it does NOT
		 * list "realtek,rtl8367rb"). Use "realtek,rtl8365mb" so the
		 * stock module probes this node; the driver's rtl8365mb_detect()
		 * still auto-detects the actual RTL8367RB-VB chip by reading
		 * the chip id over SMI (strings "RTL8367S"/"RTL8367RB-VB" are
		 * built into the module), exactly like it does for switch0
		 * which is also an RTL8367S behind the rtl8365mb compatible. */
		compatible = "realtek,rtl8365mb";
		mdc-gpios = <&gpio4 RK_PA4 GPIO_ACTIVE_HIGH>;
		mdio-gpios = <&gpio4 RK_PA5 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio4 RK_PB7 GPIO_ACTIVE_LOW>;
		/* Each switch is the sole member of its own DSA tree, so both
		 * get ds->index = 0. This is required because fnos ships the
		 * upstream tag_rtl8_4.ko which hardcodes
		 * dsa_conduit_find_user(dev, 0, port) -- device index 0. With
		 * dsa,member = <1 1> (index 1) the RX path could never resolve
		 * the user port and logged "could not find user for port N"
		 * for every ingress frame on end0. Using <1 0> makes switch1
		 * index 0 in tree 1, so the hardcoded lookup succeeds. */
		dsa,member = <1 0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "eth6";
				local-mac-address = [02 00 00 00 00 08];
				phy-handle = <&sw1_phy0>;
			};

			port@1 {
				reg = <1>;
				label = "eth7";
				local-mac-address = [02 00 00 00 00 09];
				phy-handle = <&sw1_phy1>;
			};

			port@2 {
				reg = <2>;
				label = "eth8";
				local-mac-address = [02 00 00 00 00 0a];
				phy-handle = <&sw1_phy2>;
			};

			port@3 {
				reg = <3>;
				label = "eth9";
				local-mac-address = [02 00 00 00 00 0b];
				phy-handle = <&sw1_phy3>;
			};

			port@4 {
				reg = <4>;
				label = "eth10";
				local-mac-address = [02 00 00 00 00 0c];
				phy-handle = <&sw1_phy4>;
			};

			/* CPU port: upstream rtl8365mb caps at 11 ports (mask 0x07FF),
			 * so port@16 (used by the Rockchip BSP proprietary rtl_api
			 * driver) is rejected.
			 *
			 * We use port@6 which maps to extint 1 in the rtl8365mb driver.
			 * The official Rockchip BSP rtl8367b driver maps RTL8367R_VB's
			 * cpu_port=5 → extif 1, and extif 1 corresponds to extint 1 in
			 * rtl8365mb (same physical RGMII interface, uses CHIP_DEBUG0/1
			 * registers, not CHIP_DEBUG2). On RTL8367RB-VB, extint 1
			 * supports RGMII (unlike RTL8367S where extint 1 is SGMII-only).
			 *
			 * port@7 + extint 2 was tried first but gmac0's DMA SFT_RESET
			 * stayed stuck (no RGMII RX clock), suggesting the board's
			 * RGMII traces for switch1 are physically routed to extint 1. */
			port@6 {
				reg = <6>;
				ethernet = <&gmac0>;
				phy-mode = "rgmii";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};

		mdio {
			compatible = "realtek,smi-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			sw1_phy0: ethernet-phy@0 {
				reg = <0>;
			};

			sw1_phy1: ethernet-phy@1 {
				reg = <1>;
			};

			sw1_phy2: ethernet-phy@2 {
				reg = <2>;
			};

			sw1_phy3: ethernet-phy@3 {
				reg = <3>;
			};

			sw1_phy4: ethernet-phy@4 {
				reg = <4>;
			};
		};
	};
};

&combphy0_ps {
	status = "disabled";
};

&combphy1_ps {
	status = "disabled";
};

&combphy2_psu {
	status = "disabled";
};

&cpu_l0 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l1 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l2 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l3 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_b0 {
	cpu-supply = <&vdd_cpu_big0_s0>;
};

&cpu_b1 {
	cpu-supply = <&vdd_cpu_big0_s0>;
};

&cpu_b2 {
	cpu-supply = <&vdd_cpu_big1_s0>;
};

&cpu_b3 {
	cpu-supply = <&vdd_cpu_big1_s0>;
};

/* GMAC1 (fe1c0000) — DSA CPU port for switch0 (RTL8365MB, eth1..eth5).
 * Uses wired SPI interrupts (GIC_SPI 234/233), NOT MSI, so it is safe
 * to enable even with ITS disabled. No PHY is attached directly; the
 * MAC links to the switch over RGMII with a fixed 1000M link.
 * Matches the official 6.1 BSP topology. */
&gmac1 {
	clock_in_out = "output";
	phy-mode = "rgmii";
	label = "end1";
	local-mac-address = [02 00 00 00 00 02];
	tx_delay = <0x4f>;
	rx_delay = <0x0f>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_tx_bus2
		     &gmac1_rx_bus2
		     &gmac1_rgmii_clk
		     &gmac1_rgmii_bus>;
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

/* GMAC0 (fe1b0000) — DSA CPU port for switch1 (RTL8367RB, eth6..eth10).
 * Uses wired SPI interrupts (GIC_SPI 227/226), NOT MSI. Like gmac1, the
 * MAC links to the switch over RGMII with a fixed 1000M link. */
&gmac0 {
	clock_in_out = "output";
	phy-mode = "rgmii";
	label = "end0";
	local-mac-address = [02 00 00 00 00 01];
	tx_delay = <0x4f>;
	rx_delay = <0x0f>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_tx_bus2
		     &gmac0_rx_bus2
		     &gmac0_rgmii_clk
		     &gmac0_rgmii_bus>;
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

/* Use a single RX/TX queue on both GMAC CPU ports, matching the official
 * 6.1 BSP. The inherited rk3588 dtsi configures 2 queues, which leaves
 * TX queue 1 stalled on gmac0 and triggers the NETDEV WATCHDOG /
 * "Failed to reset the dma" loop. With rx/tx-queues-to-use = <1> only
 * queue 0 is used and the watchdog no longer fires. */
&gmac0_mtl_rx_setup {
	snps,rx-queues-to-use = <1>;
};

&gmac0_mtl_tx_setup {
	snps,tx-queues-to-use = <1>;
};

&gmac1_mtl_rx_setup {
	snps,rx-queues-to-use = <1>;
};

&gmac1_mtl_tx_setup {
	snps,tx-queues-to-use = <1>;
};

&gpu {
	/* fnos ships Rockchip's vendor mali driver (rkgpu_bifrost_csf.ko)
	 * whose of_match_table lists "rockchip,rk3588-mali-csf" and
	 * "arm,mali-valhall". The upstream dtsi compatible
	 * "arm,mali-valhall-csf" is NOT in that table, so add the vendor
	 * string first to ensure the stock module matches. */
	compatible = "rockchip,rk3588-mali-csf", "rockchip,rk3588-mali",
		     "arm,mali-valhall-csf";
	mali-supply = <&vdd_gpu_s0>;
	status = "okay";
};

/* Re-enable ITS to match the official 6.1 BSP. The official kernel runs
 * with both ITS nodes enabled and no MSI hangs, so the RK3588001 erratum
 * does not affect this board. Keeping ITS disabled was found to correlate
 * with gmac0's SPI 227 interrupt never being delivered (eth1 IRQ count
 * stuck at 0, DMA watchdog loop), while the official kernel with ITS
 * enabled sees SPI 227 fire normally.
 * Also add dma-coherent to match the official DT (which has neither
 * dma-coherent nor dma-noncoherent, i.e. default coherent). The upstream
 * 6.18 rk3588 dtsi sets dma-noncoherent, forcing non-shareable ITS memory
 * which can break MSI; dma-coherent overrides that. */
&its0 {
	status = "okay";
	dma-coherent;
};

&its1 {
	status = "okay";
	dma-coherent;
};

/* Match the official 6.1 BSP: the GIC node there has no mbi-alias /
 * mbi-ranges / msi-controller properties, so the gic-v3-mbi MSI domain
 * is never created. The upstream 6.18 rk3588 dtsi adds mbi-ranges=<424 56>
 * which enables MBI; override it to an empty range so mbi_init() bails out
 * and does not register a competing MSI domain. Wired SPIs (including
 * gmac0 SPI 227) then behave exactly as on the official BSP. */
&gic {
	mbi-ranges = <0 0>;
};

&mmu600_pcie {
	status = "disabled";
};

&mmu600_php {
	status = "disabled";
};

&av1d {
	status = "disabled";
};

&av1d_mmu {
	status = "disabled";
};

&rga3_core1 {
	status = "disabled";
};

&rga3_1_mmu {
	status = "disabled";
};

&vepu121_1 {
	status = "disabled";
};

&vepu121_1_mmu {
	status = "disabled";
};

&vepu121_2 {
	status = "disabled";
};

&vepu121_2_mmu {
	status = "disabled";
};

&vepu121_3 {
	status = "disabled";
};

&vepu121_3_mmu {
	status = "disabled";
};

&vdec1 {
	status = "disabled";
};

&vdec1_mmu {
	status = "disabled";
};

&hdmi0 {
	status = "disabled";
};

&hdmi0_out {
	hdmi0_out_con: endpoint {
		remote-endpoint = <&hdmi0_con_in>;
	};
};

&hdmi1 {
	frl-enable-gpios = <&gpio1 RK_PC6 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&hdmim1_tx1_cec &hdmim0_tx1_hpd
		     &hdmim2_tx1_scl &hdmim2_tx1_sda &hdmi1_tx_on_h>;
	pinctrl-names = "default";
	status = "disabled";
};

&hdmi1_in {
	hdmi1_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_hdmi1>;
	};
};

&hdmi1_out {
	hdmi1_out_con: endpoint {
		remote-endpoint = <&hdmi1_con_in>;
	};
};

&hdmi1_sound {
	status = "disabled";
};

&hdmi_receiver_cma {
	status = "disabled";
};

&hdmi_receiver {
	hpd-gpios = <&gpio1 RK_PD5 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&hdmim1_rx_cec &hdmim1_rx_hpdin &hdmim1_rx_scl &hdmim1_rx_sda &hdmirx_hpd>;
	pinctrl-names = "default";
	status = "disabled";
};

&hdptxphy0 {
	status = "disabled";
};

&hdptxphy1 {
	status = "disabled";
};

/* i2c0: CPU big-cluster regulators (rk8602@42 + rk8603@43), matching
 * the official 6.1 BSP. Uses i2c0m2_xfer (gpio0 PD1/PD2) — same pinctrl
 * mux as official DT (phandle 0x6f). */
&i2c0 {
	pinctrl-0 = <&i2c0m2_xfer>;
	pinctrl-names = "default";
	status = "okay";

	vdd_cpu_big0_s0: regulator@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu_big0_s0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc4v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vdd_cpu_big1_s0: regulator@43 {
		compatible = "rockchip,rk8603", "rockchip,rk8602";
		reg = <0x43>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu_big1_s0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc4v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

/* i2c1 disabled — matches official 6.1 BSP. No devices on this bus. */
&i2c1 {
	status = "disabled";
};

/* i2c2: only vdd_npu_s0 (rk8602@42), matching the official 6.1 BSP.
 * Uses i2c2m0_xfer (gpio0 PB7/PB8) — same pinctrl mux as official DT. */
&i2c2 {
	pinctrl-0 = <&i2c2m0_xfer>;
	pinctrl-names = "default";
	status = "okay";

	vdd_npu_s0: regulator@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_npu_s0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <950000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc4v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

/* i2c6 disabled — Type-C/RTC/GPIO-expander not needed for recovery.
 * Disabling avoids dangling phandle to removed usbdp_phy0_typec_ss. */
&i2c6 {
	status = "disabled";

	nca9555: gpio-expander@20 {
		compatible = "nxp,pca9555";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "disabled";
	};

	usbc0: usb-typec@22 {
		compatible = "fcs,fusb302";
		reg = <0x22>;
		status = "disabled";
	};

	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-output-names = "hym8563";
		status = "disabled";
	};
};

/* i2c7 has audio codec + watchdog — not needed for recovery */
&i2c7 {
	status = "disabled";
};

&i2c8 {
	pinctrl-0 = <&i2c8m2_xfer>;
	pinctrl-names = "default";
};

&i2s0_8ch {
	status = "disabled";
};

&i2s5_8ch {
	status = "disabled";
};

&i2s6_8ch {
	status = "disabled";
};

&package_thermal {
	polling-delay = <1000>;

	trips {
		package_warm: package-warm {
			temperature = <55000>;
			hysteresis = <2000>;
			type = "active";
		};

		package_hot: package-hot {
			temperature = <65000>;
			hysteresis = <2000>;
			type = "active";
		};
	};

	cooling-maps {
		map0 {
			trip = <&package_warm>;
			cooling-device = <&fan THERMAL_NO_LIMIT 1>;
		};

		map1 {
			trip = <&package_hot>;
			cooling-device = <&fan 2 THERMAL_NO_LIMIT>;
		};
	};
};

&pcie2x1l0 {
	status = "disabled";
};

&pcie2x1l1 {
	status = "disabled";
};

&pcie2x1l2 {
	status = "disabled";
};

&pcie30phy {
	/* Match the official 6.1 BSP: phymode = <4> means the combo PHY is
	 * wired to the pcie3x4 controller (4-lane PCIe 3.0). */
	rockchip,pcie30-phymode = <4>;
	status = "okay";
};

&pcie3x4 {
	/* Enable the 4-lane PCIe 3.0 controller for the M.2 NVMe slot.
	 * All overrides below match the official factory firmware DTB
	 * (factory/boot.img-unpack rk-kernel.dtb, model "Rockchip RK3588
	 * NVR DEMO LP4 V10 S60 Board") to ensure the stock fnos kernel
	 * driver (pcie-dw-plat via "snps,dw-pcie") probes correctly.
	 *
	 * CRITICAL: the upstream dtsi uses compatible "rockchip,rk3568-pcie"
	 * which binds the pcie-dw-rockchip driver; that driver expects
	 * different reg-names/resets and caused a boot hang. The factory
	 * DTB uses "snps,dw-pcie" which binds the generic pcie-dw-plat
	 * driver — that is what we must match. */
	compatible = "rockchip,rk3588-pcie", "snps,dw-pcie";
	reg-names = "pcie-apb", "pcie-dbi", "config";
	reset-names = "pcie", "periph";
	rockchip,pipe-grf = <&php_grf>;
	num-ib-windows = <16>;
	num-ob-windows = <16>;
	num-viewport = <8>;
	/* The upstream dtsi adds iommu-map referencing mmu600_pcie which
	 * we keep disabled; remove it by overriding to empty (the factory
	 * DTB has no iommu-map at all). */
	/delete-property/ iommu-map;
	/* Board-specific GPIO and supply (same as factory DTB):
	 *   reset-gpios   = gpio4 RK_PC6 (PERST#)
	 *   vpcie3v3-supply = vcc3v3_pcie30 (gpio2 RK_PC5 enable) */
	reset-gpios = <&gpio4 RK_PC6 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie30>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie30x4_rst>;
	status = "okay";
};

&pinctrl {
	hdmi {
		hdmi1_tx_on_h: hdmi1-tx-on-h {
			rockchip,pins = <1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	hdmirx {
		hdmirx_hpd: hdmirx-5v-detection {
			rockchip,pins = <1 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pcie {
		pcie2_0_rst: pcie2-0-rst {
			rockchip,pins = <3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		pcie2_2_rst: pcie2-2-rst {
			rockchip,pins = <1 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		pcie_m2_0_pwren: pcie-m20-pwren {
			rockchip,pins = <2 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		/* PERST# for the M.2 NVMe slot (pcie3x4), matching the
		 * official factory firmware: gpio4 RK_PC6. */
		pcie30x4_rst: pcie30x4-rst {
			rockchip,pins = <4 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		wifi_poweren: wifi-poweren {
			rockchip,pins = <1 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	usb {
		usbc0_int: usbc0-int {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	sdmmc {
		sd_s0_pwren: sd-s0-pwren {
			rockchip,pins = <3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sdio {
		sdiom0_pins: sdiom0-pins {
			rockchip,pins =
				/* sdio_clk_m0 */
				<2 RK_PB3 2 &pcfg_pull_none>,
				/* sdio_cmd_m0 */
				<2 RK_PB2 2 &pcfg_pull_up>,
				/* sdio_d0_m0 */
				<2 RK_PA6 2 &pcfg_pull_up>,
				/* sdio_d1_m0 */
				<2 RK_PA7 2 &pcfg_pull_up>,
				/* sdio_d2_m0 */
				<2 RK_PB0 2 &pcfg_pull_up>,
				/* sdio_d3_m0 */
				<2 RK_PB1 2 &pcfg_pull_up>;
		};
	};
};

/* pwm14 enabled for pwm-fan (fan on pwm14m0_pins), matching official BSP.
 * pwm1 is disabled — it was incorrectly used for the fan before. */
&pwm1 {
	status = "disabled";
};

&pwm14 {
	status = "okay";
	pinctrl-0 = <&pwm14m0_pins>;
	pinctrl-names = "default";
};

/* ---- NPU ----
 * fnos ships Rockchip's vendor rknpu.ko whose of_match_table lists
 * "rockchip,rk3588-rknpu" (a SINGLE node covering all 3 cores), NOT the
 * upstream "rockchip,rk3588-rknn-core" (three separate nodes).
 *
 * Strategy: repurpose the existing rknn_core_0 node (already at
 * 0xfdab0000) by overriding its compatible/properties to match the
 * vendor driver, delete the other two core nodes, and disable all
 * three upstream mmu nodes (keep them for the phandle reference but
 * never probe).
 *
 * NOTE on iommu: the BSP uses "rockchip,iommu-v2" for the NPU iommu,
 * but fnos has no driver for that compatible (only the upstream
 * "rockchip,rk3588-iommu"). If the upstream rockchip-iommu driver
 * probes the NPU iommu, it request_mem_region's 0xfdab9000, which
 * overlaps the NPU's 64KB reg window (0xfdab0000-0xfdabffff) and
 * produces -EBUSY. Keep rknn_mmu_0 status="disabled" so the iommu
 * driver never probes; the rknpu driver then runs in non-iommu mode
 * ("using non-iommu mode"), which is exactly how the official BSP
 * behaves on fnos (its iommu-v2 driver simply never matched).
 */
/delete-node/ &rknn_core_1;
/delete-node/ &rknn_core_2;

/* Keep rknn_mmu_* nodes present (so the iommus phandle resolves) but
 * disabled, so the rockchip-iommu driver never probes them. */
&rknn_mmu_0 { status = "disabled"; };
&rknn_mmu_1 { status = "disabled"; };
&rknn_mmu_2 { status = "disabled"; };

/* Repurpose rknn_core_0 (npu@fdab0000) as the vendor-style single NPU
 * node. Override compatible, expand reg to cover all 3 cores, add the
 * 2nd/3rd interrupts, 3 power domains, rknpu-supply for DVFS. */
&rknn_core_0 {
	compatible = "rockchip,rk3588-rknpu";
	reg = <0x0 0xfdab0000 0x0 0x10000>,
	      <0x0 0xfdac0000 0x0 0x10000>,
	      <0x0 0xfdad0000 0x0 0x10000>;
	reg-names = "pc", "cna", "core";
	interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH 0>,
		     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH 0>,
		     <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH 0>;
	interrupt-names = "npu0_irq", "npu1_irq", "npu2_irq";
	clocks = <&cru ACLK_NPU0>, <&cru ACLK_NPU1>,
		 <&cru ACLK_NPU2>, <&cru HCLK_NPU0>,
		 <&cru HCLK_NPU1>, <&cru HCLK_NPU2>,
		 <&scmi_clk SCMI_CLK_NPU>, <&cru PCLK_NPU_ROOT>;
	clock-names = "aclk0", "aclk1", "aclk2",
		      "hclk0", "hclk1", "hclk2",
		      "npu", "pclk";
	resets = <&cru SRST_A_RKNN0>, <&cru SRST_A_RKNN1>,
		 <&cru SRST_A_RKNN2>, <&cru SRST_H_RKNN0>,
		 <&cru SRST_H_RKNN1>, <&cru SRST_H_RKNN2>;
	reset-names = "srst_a0", "srst_a1", "srst_a2",
		      "srst_h0", "srst_h1", "srst_h2";
	power-domains = <&power RK3588_PD_NPUTOP>,
			<&power RK3588_PD_NPU1>,
			<&power RK3588_PD_NPU2>;
	power-domain-names = "npu0", "npu1", "npu2";
	operating-points-v2 = <&npu_opp_table>;
	/* iommus points at the (disabled) rknn_mmu_0. Because the mmu node
	 * is status="disabled", the iommu driver never probes and the rknpu
	 * driver falls back to non-iommu mode. Keeping the reference avoids
	 * a DTC phandle error. */
	iommus = <&rknn_mmu_0>;
	rknpu-supply = <&vdd_npu_s0>;
	status = "okay";
};

&{/} {
	npu_opp_table: opp-table-npu {
		compatible = "operating-points-v2";

		opp-300000000 {
			opp-hz = /bits/ 64 <300000000>;
			opp-microvolt = <700000 700000 850000>;
		};
		opp-400000000 {
			opp-hz = /bits/ 64 <400000000>;
			opp-microvolt = <700000 700000 850000>;
		};
		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <700000 700000 850000>;
		};
		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <700000 700000 850000>;
		};
		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
			opp-microvolt = <750000 750000 850000>;
		};
		opp-800000000 {
			opp-hz = /bits/ 64 <800000000>;
			opp-microvolt = <800000 800000 850000>;
		};
		opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <850000 850000 850000>;
		};
		opp-1000000000 {
			opp-hz = /bits/ 64 <1000000000>;
			opp-microvolt = <900000 900000 950000>;
		};
	};
};

&saradc {
	vref-supply = <&avcc_1v8_s0>;
	status = "okay";
};

&sdhci {
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	max-frequency = <200000000>;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	status = "okay";
};

&sdio {
	bus-width = <4>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs400-1_8v;
	non-removable;
	no-sd;
	no-sdio;
	keep-power-in-suspend;
	max-frequency = <150000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdiom0_pins>;
	status = "disabled";
};

&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	no-mmc;
	no-sdio;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc3v3_sd_s0>;
	vqmmc-supply = <&vccio_sd_s0>;
	status = "disabled";
};

/* optional on non-LTS, populated on LTS version */
&sfc {
	status = "disabled";
};

&spi2 {
	status = "okay";
	assigned-clocks = <&cru CLK_SPI2>;
	assigned-clock-rates = <200000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi2m2_cs0 &spi2m2_pins>;
	num-cs = <1>;

	pmic@0 {
		compatible = "rockchip,rk806";
		spi-max-frequency = <1000000>;
		reg = <0x0>;

		interrupt-parent = <&gpio0>;
		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pmic_pins>;

		system-power-controller;

		vcc1-supply = <&vcc4v0_sys>;
		vcc2-supply = <&vcc4v0_sys>;
		vcc3-supply = <&vcc4v0_sys>;
		vcc4-supply = <&vcc4v0_sys>;
		vcc5-supply = <&vcc4v0_sys>;
		vcc6-supply = <&vcc4v0_sys>;
		vcc7-supply = <&vcc4v0_sys>;
		vcc8-supply = <&vcc4v0_sys>;
		vcc9-supply = <&vcc4v0_sys>;
		vcc10-supply = <&vcc4v0_sys>;
		vcc11-supply = <&vcc4v0_sys>;
		vcc12-supply = <&vcc4v0_sys>;
		vcc13-supply = <&vcc4v0_sys>;
		vcc14-supply = <&vcc4v0_sys>;
		vcca-supply = <&vcc4v0_sys>;

		gpio-controller;
		#gpio-cells = <2>;

		regulators {
			vdd_gpu_s0: vdd_gpu_mem_s0: dcdc-reg1 {
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_gpu_s0";
				regulator-enable-ramp-delay = <400>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_cpu_lit_s0: vdd_cpu_lit_mem_s0: dcdc-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_cpu_lit_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_log_s0: dcdc-reg3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <675000>;
				regulator-max-microvolt = <750000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_log_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <750000>;
				};
			};

			vdd_vdenc_s0: vdd_vdenc_mem_s0: dcdc-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_vdenc_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_ddr_s0: dcdc-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <675000>;
				regulator-max-microvolt = <900000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_ddr_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <850000>;
				};
			};

			vdd2_ddr_s3: dcdc-reg6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vdd2_ddr_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_2v0_pldo_s3: dcdc-reg7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <2000000>;
				regulator-max-microvolt = <2000000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vcc_2v0_pldo_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <2000000>;
				};
			};

			vcc_3v3_s3: dcdc-reg8 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc_3v3_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vddq_ddr_s0: dcdc-reg9 {
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vddq_ddr_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_1v8_s3: dcdc-reg10 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_1v8_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			avcc_1v8_s0: pldo-reg1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "avcc_1v8_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_1v8_s0: pldo-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_1v8_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			avdd_1v2_s0: pldo-reg3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-name = "avdd_1v2_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_3v3_s0: pldo-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vcc_3v3_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_sd_s0: pldo-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vccio_sd_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			pldo6_s3: pldo-reg6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "pldo6_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdd_0v75_s3: nldo-reg1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <750000>;
				regulator-name = "vdd_0v75_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <750000>;
				};
			};

			vdd_ddr_pll_s0: nldo-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-name = "vdd_ddr_pll_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <850000>;
				};
			};

			avdd_0v75_s0: nldo-reg3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <750000>;
				regulator-name = "avdd_0v75_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_0v85_s0: nldo-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-name = "vdd_0v85_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_0v75_s0: nldo-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <750000>;
				regulator-name = "vdd_0v75_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
	};
};

&tsadc {
	status = "okay";
};

&uart2 {
	pinctrl-0 = <&uart2m0_xfer>;
	pinctrl-names = "default";
	status = "okay";
};

/* All USB disabled — headless recovery doesn't need USB.
 * Also USB controllers use MSI via ITS which hangs on RK3588001 erratum. */
/* USB — match the official factory firmware. Enable u2phy0/2/3 and the
 * ehci/ohci host controllers for the USB-A ports. The OTG controller
 * (usb_host0_xhci) is enabled in otg mode with usb-role-switch.
 * u2phy1 and usbdp_phy1 stay disabled (factory firmware disables them). */
&u2phy0 { status = "okay"; };
&u2phy0_otg { status = "okay"; };
&u2phy2 { status = "okay"; };
&u2phy2_host { status = "okay"; };
&u2phy3 { status = "okay"; };
&u2phy3_host { status = "okay"; };
&usbdp_phy0 { status = "okay"; };
&usbdp_phy1 { status = "disabled"; };
&u2phy1 { status = "disabled"; };
&u2phy1_otg { status = "disabled"; };
&usb_host0_ehci { status = "okay"; };
&usb_host0_ohci { status = "okay"; };
&usb_host0_xhci {
	dr_mode = "otg";
	usb-role-switch;
	status = "okay";
};
&usb_host1_ehci { status = "okay"; };
&usb_host1_ohci { status = "okay"; };
&usb_host1_xhci { status = "disabled"; };
&usb_host2_xhci { status = "disabled"; };

/* VOP/display disabled — headless recovery */
&vop { status = "disabled"; };
&vop_mmu { status = "disabled"; };

&vp0 {
	vp0_out_hdmi1: endpoint@ROCKCHIP_VOP2_EP_HDMI1 {
		reg = <ROCKCHIP_VOP2_EP_HDMI1>;
		remote-endpoint = <&hdmi1_in_vp0>;
	};
};

&vp1 {
};

&wdt {
	status = "disabled";
};
